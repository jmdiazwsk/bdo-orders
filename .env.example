APP_NAME=BDO Orders Platform
APP_ENV=dev

# DB (Postgres)
DB_HOST=localhost
DB_PORT=5433
DB_USER=orders
DB_PASSWORD=orders
DB_NAME=orders_db
POSTGRES_DB=orders_db
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://orders:orders@localhost:5433/orders_db
SYNC_DATABASE_URL=postgresql+psycopg://orders:orders@localhost:5433/orders_db

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_ORDERS_TOPIC=orders
KAFKA_BROKER_ID=1

# AWS mock (LocalStack)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=eu-west-1
AWS_SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:bdo-alerts
AWS_S3_BUCKET=bdo-orders


# LocalStack
LOCALSTACK_SERVICES=sns,s3
LOCALSTACK_EDGE_PORT=4566

# API
API_PORT=8000



